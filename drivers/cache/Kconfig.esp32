config CACHE_ESP32
	bool "Espressif ESP32 cache driver"
	default y
	depends on SOC_FAMILY_ESPRESSIF_ESP32 && CACHE_MANAGEMENT
	select CACHE_HAS_DRIVER
	help
	  Enable cache management driver for Espressif SoCs that access
	  internal SRAM through an L2 cache (e.g. ESP32-P4).
