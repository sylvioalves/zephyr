menuconfig PULSE_IO
	bool "Pulse IO drivers"
	help
	  Enable support for the Pulse IO subsystem, a vendor-neutral
	  abstraction for hardware that generates and captures timed
	  digital edges on a GPIO line.

if PULSE_IO

module = PULSE_IO
module-str = pulse_io
source "subsys/logging/Kconfig.template.log_config"

config PULSE_IO_INIT_PRIORITY
	int "Pulse IO init priority"
	default 80
	help
	  Device driver init priority for Pulse IO devices.

config PULSE_IO_LOOPBACK
	bool "Software loopback Pulse IO backend"
	default y
	depends on DT_HAS_ZEPHYR_PULSE_IO_LOOPBACK_ENABLED
	help
	  Enable the software loopback Pulse IO backend. It loops
	  transmitted symbols back on receive so the subsystem API can
	  be tested without hardware.

config PULSE_IO_ESP32_RMT
	bool "Espressif RMT Pulse IO backend"
	default y
	depends on DT_HAS_ESPRESSIF_ESP32_RMT_ENABLED
	help
	  Enable the Espressif RMT (Remote Control Transceiver) Pulse IO
	  backend.

config PULSE_IO_ESP32_RMT_DMA
	def_bool SOC_SERIES_ESP32S3
	depends on PULSE_IO_ESP32_RMT
	select DMA if DT_HAS_ESPRESSIF_ESP32_GDMA_ENABLED
	help
	  Compile the RMT DMA path on SoCs whose RMT DMA generation the
	  backend supports.

config PULSE_IO_ESP32_RMT_DMA_WORDS
	int "RMT DMA buffer size in RMT words"
	depends on PULSE_IO_ESP32_RMT_DMA
	default 256
	help
	  Size of the static transmit and receive DMA bounce buffers,
	  in RMT symbol words (4 bytes each). Only used by the last
	  transmit and receive channels when DMA is enabled through the
	  dmas devicetree property.

endif # PULSE_IO
