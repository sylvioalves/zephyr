#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/*
 * The LEDC PWM output (GPIO2) is the pulse stimulus and the PCNT signal input is
 * on GPIO3. Wire a jumper from GPIO2 to GPIO3 so a PWM burst is counted by the
 * pulse counter.
 */
/ {
	stim_pwm: stim_pwm {
		compatible = "pwm-leds";

		stim_pwm_ch: stim_pwm_ch {
			pwms = <&ledc0 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
			label = "pcnt stimulus";
		};
	};

	aliases {
		pcnt-stim = &stim_pwm_ch;
	};
};

&pinctrl {
	ledc0_default: ledc0_default {
		group1 {
			pinmux = <LEDC_CH0_GPIO2>;
			output-enable;
		};
	};

	pcnt_default: pcnt_default {
		group1 {
			pinmux = <PCNT0_CH0SIG_GPIO3>;
			input-enable;
			bias-pull-down;
		};
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

&pcnt {
	status = "okay";
	pinctrl-0 = <&pcnt_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	unit0@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;
		filter = <0>;

		channel0@0 {
			reg = <0>;
			sig-pos-mode = <1>;
			sig-neg-mode = <0>;
		};
	};
};
