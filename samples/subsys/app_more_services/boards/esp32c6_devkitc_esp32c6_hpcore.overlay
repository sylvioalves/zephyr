/ {
	aliases {
		more-led = &more_led;
		more-counter = &timer0_counter;
	};

	more_led_pins {
		compatible = "gpio-leds";

		more_led: more_led {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			label = "more services led";
		};
	};
};

/* Enable a hardware timer + its counter for the one-shot timer service. */
&timer0 {
	status = "okay";

	timer0_counter: counter {
		status = "okay";
	};
};
