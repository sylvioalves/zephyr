/*
 * A counter-backed wall clock: enable timer0's counter and nest a virtual RTC
 * under it (the rtc-counter driver takes its counter from its parent node) so
 * the service can keep calendar time.
 */
&timer0 {
	status = "okay";

	counter {
		status = "okay";

		counter_rtc: counter-rtc {
			compatible = "zephyr,rtc-counter";
			status = "okay";
			alarms-count = <0>;
		};
	};
};
