/*
 * A secondary UART for the platform's uart service, looped back on itself so
 * the sample can check what it writes. The SoC matrix routes both the transmit
 * and the receive signal of UART1 to GPIO9, so the pad carries the output
 * straight back into the input and no wire is needed.
 */

#include <zephyr/dt-bindings/pinctrl/esp32c5-pinctrl.h>

&pinctrl {
	uart1_loopback: uart1_loopback {
		group1 {
			pinmux = <UART1_TX_GPIO9>,
				 <UART1_RX_GPIO9>;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_loopback>;
	pinctrl-names = "default";
};

/ {
	chosen {
		app-uart = &uart1;
	};
};
