/* Declare the base counters so user threads may read the cycle counter on
 * every hart.
 */
/ {
	cpus {
		riscv,isa-extensions = "i", "m", "a", "f", "d", "c", "zicsr", "zifencei", "zkr",
				       "zicntr";
	};
};
