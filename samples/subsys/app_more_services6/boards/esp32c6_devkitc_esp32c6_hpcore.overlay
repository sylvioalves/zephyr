#include <zephyr/dt-bindings/pinctrl/esp32c6-pinctrl.h>

/*
 * CAN/TWAI internal loopback: TX and RX are both muxed to GPIO5 (output and
 * input enabled on the same pin) so a sent frame is wired straight back to the
 * receiver. No external transceiver or bus is needed.
 */
&pinctrl {
	twai_default: twai_default {
		group1 {
			pinmux = <TWAI0_RX_GPIO5>;
			output-enable;
		};

		group2 {
			pinmux = <TWAI0_TX_GPIO5>;
			input-enable;
		};
	};
};

&twai0 {
	status = "okay";
	bitrate = <125000>;
	pinctrl-0 = <&twai_default>;
	pinctrl-names = "default";

	can-transceiver {
		max-bitrate = <1000000>;
	};
};
