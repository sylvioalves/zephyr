#include <zephyr/dt-bindings/gpio/gpio.h>

/* QEMU has no die temperature sensor: stand in an emulated one. */
/ {
	die_temp: die_temp {
		compatible = "zephyr,generic-emul-sensor";
		status = "okay";
	};

	aliases {
		die-temp0 = &die_temp;
	};
};

/* QEMU has no LED: drive one on an emulated GPIO controller. */
/ {
	gpio_emul: gpio_emul {
		compatible = "zephyr,gpio-emul";
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		status = "okay";
	};

	sdk_led_pins {
		compatible = "gpio-leds";

		sdk_led: sdk_led {
			gpios = <&gpio_emul 0 GPIO_ACTIVE_HIGH>;
			label = "sdk led";
		};
	};

	aliases {
		sdk-led = &sdk_led;
	};
};
