/ {
	aliases {
		sdk-led = &sdk_led;
	};

	sdk_led_pins {
		compatible = "gpio-leds";

		sdk_led: sdk_led {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			label = "sdk led";
		};
	};
};

&coretemp {
	status = "okay";
};
