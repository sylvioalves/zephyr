#include <zephyr/dt-bindings/pinctrl/esp32c5-pinctrl.h>

/* MCPWM operator-0 outputs: PWM0A on GPIO4 (channel 0), PWM0B on GPIO5 (channel 1). */
&pinctrl {
	mcpwm0_default: mcpwm0_default {
		group1 {
			pinmux = <MCPWM0_OUT0A_GPIO4>,
				 <MCPWM0_OUT0B_GPIO5>;
			output-enable;
		};
	};
};

&mcpwm0 {
	pinctrl-0 = <&mcpwm0_default>;
	pinctrl-names = "default";
	prescale = <255>;
	prescale-timer0 = <103>;
	status = "okay";
};
