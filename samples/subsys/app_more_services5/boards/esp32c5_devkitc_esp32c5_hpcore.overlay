#include <zephyr/dt-bindings/pinctrl/esp32c5-pinctrl.h>

/* Second UART: TX on GPIO4, RX on GPIO5 (free pins on the devkit). */
&pinctrl {
	uart1_default: uart1_default {
		group1 {
			pinmux = <UART1_TX_GPIO4>;
			output-high;
		};

		group2 {
			pinmux = <UART1_RX_GPIO5>;
			bias-pull-up;
		};
	};
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_default>;
	pinctrl-names = "default";
};

/* Die-temperature sensor: enabled for the read-only service. */
&coretemp {
	status = "okay";
};
