/*
 * The devkit exposes a user button (sw0, GPIO9) but no simple GPIO LEDs. Define
 * three status LEDs on free pins so the LED service has a multi-pin output set
 * to grant from.
 */
/ {
	leds {
		compatible = "gpio-leds";

		led_a: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "status LED 0";
		};

		led_b: led_1 {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "status LED 1";
		};

		led_c: led_2 {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "status LED 2";
		};
	};

	aliases {
		led0 = &led_a;
		led1 = &led_b;
		led2 = &led_c;
	};
};
