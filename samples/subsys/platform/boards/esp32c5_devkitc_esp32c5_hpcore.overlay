#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	leds {
		compatible = "gpio-leds";

		status_led: led_0 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "status LED";
		};
	};

	app_pwm: app_pwm {
		compatible = "pwm-leds";

		app_pwm_ch: app_pwm_ch {
			pwms = <&ledc0 0 PWM_HZ(1000) PWM_POLARITY_NORMAL>;
			label = "app pwm";
		};
	};

	aliases {
		led0 = &status_led;
		app-pwm = &app_pwm_ch;
	};
};

&coretemp {
	status = "okay";
};

/* PWM: LEDC channel 0 on GPIO3 (GPIO2 is the LED). */
&pinctrl {
	ledc0_default: ledc0_default {
		group1 {
			pinmux = <LEDC_CH0_GPIO3>;
			output-enable;
		};
	};
};

&ledc0 {
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};
};

/* RTC: a counter-backed wall clock over timer0. */
&timer0 {
	status = "okay";

	counter {
		status = "okay";

		counter_rtc: counter-rtc {
			compatible = "zephyr,rtc-counter";
			status = "okay";
			alarms-count = <0>;
		};
	};
};
