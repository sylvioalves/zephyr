/* The sample runs the controller in loopback, so no transceiver is needed.
 * Tie TX and RX to the same pin to give the frames a path back.
 */
&twai0 {
	status = "okay";
	pinctrl-0 = <&twai0_loopback>;
	pinctrl-names = "default";
};

&pinctrl {
	twai0_loopback: twai0_loopback {
		group1 {
			pinmux = <TWAI0_RX_GPIO14>;
			output-enable;
		};

		group2 {
			pinmux = <TWAI0_TX_GPIO14>;
			input-enable;
		};
	};
};
