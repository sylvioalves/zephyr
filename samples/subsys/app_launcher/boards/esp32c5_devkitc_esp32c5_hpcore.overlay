/* No panel on the devkit: a dummy display controller satisfies the chosen
 * node so the launcher runs headless.
 */

/ {
	chosen {
		zephyr,display = &dummy_dc;
	};

	dummy_dc: dummy_dc {
		compatible = "zephyr,dummy-dc";
		height = <240>;
		width = <320>;
	};
};
