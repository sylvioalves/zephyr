/ {
	aliases {
		sandbox-out = &sandbox_out;
		sandbox-temp = &coretemp;
	};

	sandbox_out_pins {
		compatible = "gpio-leds";

		sandbox_out: sandbox_out {
			gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
			label = "sandbox output";
		};
	};
};

&coretemp {
	status = "okay";
};
