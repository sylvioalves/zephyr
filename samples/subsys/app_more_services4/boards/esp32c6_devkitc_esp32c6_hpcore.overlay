/*
 * SPI bus 2 with two GPIO chip-selects (GPIO4 and GPIO5). Each child node is a
 * distinct target the service can address; the app is granted a subset. Wire
 * MISO (GPIO2) to MOSI (GPIO7) to see a loopback on either chip-select.
 */
&spi2 {
	status = "okay";
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	cs-gpios = <&gpio0 4 GPIO_ACTIVE_LOW>,
		   <&gpio0 5 GPIO_ACTIVE_LOW>;

	spi_target0: spi_target0@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};

	spi_target1: spi_target1@1 {
		compatible = "vnd,spi-device";
		reg = <1>;
		spi-max-frequency = <1000000>;
	};
};
