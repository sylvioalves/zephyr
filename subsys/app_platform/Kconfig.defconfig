if APP_PLATFORM && USERSPACE

configdefault MAX_THREAD_BYTES
	default 13 if APP_PLATFORM_MAX_APPS > 10
	default 13 if APP_PLATFORM_MAX_APPS > 4 && APP_PLATFORM_APP_THREADS > 0
	default 9 if APP_PLATFORM_MAX_APPS > 6
	default 9 if APP_PLATFORM_APP_THREADS > 0
	default 4

endif # APP_PLATFORM && USERSPACE

if APP_PLATFORM && MBEDTLS_PSA_CRYPTO_LEGACY_RNG

# Without an entropy driver mbed TLS runs its own DRBG from its heap, and
# verifying a module needs at least 4 KB of it.
configdefault MBEDTLS_HEAP_SIZE
	default 4096

endif # APP_PLATFORM && MBEDTLS_PSA_CRYPTO_LEGACY_RNG

if APP_PLATFORM_NET

# The net thread polls one eventfd plus a socket and an MQTT session per
# application.
configdefault ZVFS_POLL_MAX
	default 8 if APP_PLATFORM_MAX_APPS <= 3
	default 9 if APP_PLATFORM_MAX_APPS <= 4
	default 17 if APP_PLATFORM_MAX_APPS <= 8
	default 33 if APP_PLATFORM_MAX_APPS <= 16
	default 65

endif # APP_PLATFORM_NET
