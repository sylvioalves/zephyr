#
# Derive the application ABI identifier of a firmware image from its syscall
# numbering (SYSCALL_LIST) and the application interface headers
# (HEADER_DIR/*.h). The identifier is the first 16 bytes of a SHA-256 over the
# name and digest of each input. It is written as a C initializer to OUT_H.
#
# OUT_ID receives what the signer puts in a manifest for this firmware, one
# key=value per line: the identifier, the interface major version read from
# the "major" line of ABI_TABLE, and the target fingerprint TARGET with the
# description TARGET_DESC it was hashed from. OUT_H also defines TARGET as
# APP_PLATFORM_TARGET, which the loader compares with the manifest.
#
# A firmware without user mode also hashes ISOLATION=none: its applications
# call the services directly instead of through system calls, so a module built
# for one mode must not load in the other.
#
# Inputs: SYSCALL_LIST, HEADER_DIR, ISOLATION, ABI_TABLE, TARGET, TARGET_DESC,
#         OUT_H, OUT_ID.

file(GLOB headers ${HEADER_DIR}/*.h)
list(SORT headers)

file(SHA256 ${SYSCALL_LIST} digest)
set(abi "syscall_list.h:${digest}\n")
foreach(header ${headers})
  get_filename_component(name ${header} NAME)
  file(SHA256 ${header} digest)
  string(APPEND abi "${name}:${digest}\n")
endforeach()
if(ISOLATION STREQUAL "none")
  string(APPEND abi "isolation:none\n")
endif()

string(SHA256 abi "${abi}")
string(SUBSTRING ${abi} 0 32 id)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " init ${id})
string(REGEX REPLACE ", $" "" init "${init}")

file(STRINGS ${ABI_TABLE} major REGEX "^major[ \t]+[0-9]+$")
string(REGEX REPLACE "^major[ \t]+" "" major "${major}")

file(WRITE ${OUT_ID}
  "abi_id=${id}\n"
  "abi_major=${major}\n"
  "target=${TARGET}\n"
  "target_desc=${TARGET_DESC}\n")
file(WRITE ${OUT_H}
  "/* Generated by abi_id.cmake, do not edit. */\n\n"
  "#ifndef ZEPHYR_APP_PLATFORM_ABI_H_\n"
  "#define ZEPHYR_APP_PLATFORM_ABI_H_\n\n"
  "#define APP_PLATFORM_ABI_ID { ${init} }\n\n"
  "#define APP_PLATFORM_TARGET ${TARGET}U\n\n"
  "#endif\n")
