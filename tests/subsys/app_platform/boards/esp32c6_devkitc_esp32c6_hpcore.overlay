 *
 * Enlarge the storage partition for the application store. Under simple boot
 * the second firmware slot is unused, so its region is reassigned to storage.
 * The code partition and the low-power-core slots are left untouched.
 */

/delete-node/ &slot1_partition;

&storage_partition {
	reg = <0x1e0000 DT_SIZE_K(1792)>;
};

/* Two counter instances for the hardware counter service: the suite grants one
 * and withholds the other, so the per-instance grant is testable.
 */
&timer0 {
	status = "okay";

	counter {
		status = "okay";
	};
};

&timer1 {
	status = "okay";

	counter {
		status = "okay";
	};
};
