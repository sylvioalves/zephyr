/* Emulated devices for the index-keyed device services. Real silicon for these
 * classes is rare on one board, so the suite drives emulated instances and
 * checks the platform's own behaviour: the capability gate, the per-instance
 * grant and the window arithmetic.
 */

#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	dac_emul: dac_emul {
		compatible = "zephyr,dac-emul";
		nchannels = <2>;
		#io-channel-cells = <1>;
		status = "okay";
	};

	rtc_emul: rtc_emul {
		compatible = "zephyr,rtc-emul";
		status = "okay";
	};

	fake_regulator: fake_regulator {
		compatible = "zephyr,fake-regulator";

		fake_reg0: FAKEREG0 {};
	};

	fake_stepper: fake-stepper-controller {
		compatible = "zephyr,fake-stepper-ctrl";
		status = "okay";
	};

	test_gpio: test_gpio {
		compatible = "zephyr,gpio-emul";
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <8>;
		rising-edge;
		falling-edge;
		high-level;
		low-level;
		status = "okay";
	};

	leds {
		compatible = "gpio-leds";

		test_line: test_line {
			gpios = <&test_gpio 0 GPIO_ACTIVE_HIGH>;
		};

		test_led: test_led {
			gpios = <&test_gpio 1 GPIO_ACTIVE_HIGH>;
		};
	};

	buttons {
		compatible = "gpio-keys";

		test_btn: test_btn {
			gpios = <&test_gpio 4 GPIO_ACTIVE_HIGH>;
		};
	};

	app_platform {
		compatible = "zephyr,app-platform";
		gpios = <&test_gpio 0 GPIO_ACTIVE_HIGH>, <&test_gpio 2 GPIO_ACTIVE_HIGH>,
			<&test_gpio 3 GPIO_ACTIVE_LOW>;
		line-names = "test_line", "test_in", "test_low";
		dacs = <&dac_emul>;
		regulators = <&fake_reg0>;
		steppers = <&fake_stepper>;
		sensors = <&gen_sensor>;
	};

	gen_sensor: gen_sensor {
		compatible = "zephyr,generic-emul-sensor";
		status = "okay";
	};

	fake_pwm: fake_pwm {
		compatible = "zephyr,fake-pwm";
		#pwm-cells = <2>;
		frequency = <1000000>;
		status = "okay";
	};

	/* Stands in for the motor-control PWM the motor service looks up. */
	mcpwm0: fake_mcpwm {
		compatible = "zephyr,fake-pwm";
		#pwm-cells = <2>;
		frequency = <1000000>;
		status = "okay";
	};

	pwmleds {
		compatible = "pwm-leds";

		test_pwm: test_pwm {
			pwms = <&fake_pwm 0 PWM_MSEC(1)>;
		};
	};

	/* Captures the frames the WS2812 driver writes to the strip. */
	strip_uart: strip_uart {
		compatible = "vnd,serial";
		current-speed = <2500000>;
		data-bits = <7>;
		tx-invert;
		buffer-size = <1024>;
		status = "okay";

		test_strip: ws2812 {
			compatible = "worldsemi,ws2812-uart";
			one-symbol = <6>;
			zero-symbol = <4>;
			bits-per-symbol = <3>;
			chain-length = <2>;
			reset-delay = <50>;
			color-mapping = <LED_COLOR_ID_GREEN
					 LED_COLOR_ID_RED
					 LED_COLOR_ID_BLUE>;
			status = "okay";
		};
	};

	capture_display: capture_display {
		compatible = "vnd,display-capture";
		width = <160>;
		height = <24>;
		status = "okay";
	};

	adc_emul: adc_emul {
		compatible = "zephyr,adc-emul";
		nchannels = <1>;
		ref-internal-mv = <3300>;
		#io-channel-cells = <1>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		channel@0 {
			reg = <0>;
			zephyr,gain = "ADC_GAIN_1";
			zephyr,reference = "ADC_REF_INTERNAL";
			zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
			zephyr,resolution = <12>;
		};
	};

	zephyr,user {
		io-channels = <&adc_emul 0>;
	};

	aliases {
		led0 = &test_led;
		sw0 = &test_btn;
		app-pwm0 = &test_pwm;
		led-strip = &test_strip;
		app-i2c = &fake_i2c_bus;
		app-spi = &app_spi;
	};

	fake_i2c_bus: i2c@100 {
		status = "okay";
		compatible = "zephyr,i2c-emul-controller";
		clock-frequency = <I2C_BITRATE_STANDARD>;
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x100 4>;

		smartbattery0: smartbattery@b {
			compatible = "sbs,sbs-gauge-new-api";
			reg = <0x0b>;
			status = "okay";
		};

		i2c_eeprom: eeprom@57 {
			compatible = "atmel,at24";
			reg = <0x57>;
			size = <256>;
			pagesize = <8>;
			address-width = <8>;
			timeout = <5>;
			status = "okay";
		};

		sbscharger0: sbscharger@e {
			compatible = "sbs,sbs-charger";
			reg = <0x0e>;
			status = "okay";
		};
	};

	app_uart: app_uart {
		compatible = "zephyr,uart-emul";
		current-speed = <115200>;
		status = "okay";
	};

	app_spi: spi@200 {
		compatible = "zephyr,spi-emul-controller";
		reg = <0x200 4>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "okay";

		spi_echo0: echo@0 {
			compatible = "vnd,spi-echo";
			reg = <0>;
			spi-max-frequency = <8000000>;
		};

		spi_echo1: echo@1 {
			compatible = "vnd,spi-echo";
			reg = <1>;
			spi-max-frequency = <8000000>;
		};
	};

	app_can: can_loopback {
		compatible = "zephyr,can-loopback";
		status = "okay";
	};

	chosen {
		zephyr,canbus = &app_can;
		app,uart = &app_uart;
		zephyr,eeprom = &i2c_eeprom;
		zephyr,rtc = &rtc_emul;
		zephyr,fuel-gauge = &smartbattery0;
		zephyr,charger = &sbscharger0;
		zephyr,display = &capture_display;
	};
};
