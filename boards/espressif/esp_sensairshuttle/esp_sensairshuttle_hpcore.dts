/dts-v1/;

#include <espressif/esp32c5/esp32c5.dtsi>
#include "esp_sensairshuttle_hpcore-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <espressif/partitions_0x2000_default_16M.dtsi>

/ {
	compatible = "espressif,esp32c5";
	model = "Espressif ESP-SensairShuttle HP Core";

	chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,ieee802154 = &ieee802154;
		zephyr,bt-hci = &esp32_bt_hci;
		zephyr,display = &st7789p3;
		zephyr,touch = &cst816t;
	};

	aliases {
		sw0 = &boot_button;
		watchdog0 = &wdt0;
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot_button: button {
			label = "Boot Button";
			gpios = <&gpio0 28 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	lcd_audio_pwr: lcd-audio-pwr {
		compatible = "regulator-fixed";
		regulator-name = "lcd_audio_pwr";
		enable-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
		regulator-boot-on;
	};

	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		st7789p3: st7789p3@0 {
			compatible = "sitronix,st7789v";
			reg = <0>;
			mipi-max-frequency = <20000000>;
			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			width = <240>;
			height = <284>;
			x-offset = <0>;
			y-offset = <0>;
			vcom = <0x21>;
			gctrl = <0x05>;
			vrhs = <0x15>;
			vdvs = <0x20>;
			mdac = <0x00>;
			gamma = <0x01>;
			lcm = <0x2c>;
			pixel-format = <PANEL_PIXEL_FORMAT_RGB_565>;
			porch-param = [0c 0c 00 33 33];
			pwctrl1-param = [a4 a1];
			ram-param = [00 f8];
			pvgam-param = [f0 05 0e 08 0a 17 39 54 4e 37 12 12 31 37];
			nvgam-param = [f0 10 14 0d 0b 05 39 44 4d 38 14 14 2e 35];
		};
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(16)>;
	ranges = <0x0 0x0 DT_SIZE_M(16)>;
};

&psram0 {
	size = <DT_SIZE_M(8)>;
};

&usb_serial {
	status = "okay";
};

&uart0 {
	current-speed = <115200>;
	pinctrl-0 = <&uart0_default>;
	pinctrl-names = "default";
};

&gpio0 {
	status = "okay";
};

zephyr_i2c: &i2c0 {
	clock-frequency = <I2C_BITRATE_FAST>;
	sda-gpios = <&gpio0 2 GPIO_OPEN_DRAIN>;
	scl-gpios = <&gpio0 3 GPIO_OPEN_DRAIN>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	status = "okay";

	cst816t: cst816t@15 {
		compatible = "hynitron,cst8xx";
		reg = <0x15>;
		screen-width = <240>;
		screen-height = <284>;
		inverted-y;
	};
};

&spi2 {
	#address-cells = <1>;
	#size-cells = <0>;
	pinctrl-0 = <&spim2_default>;
	pinctrl-names = "default";
	status = "okay";
};

&adc0 {
	status = "okay";
};

&dma {
	status = "okay";
};

&trng0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&wifi {
	status = "okay";
};

&ieee802154 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};
