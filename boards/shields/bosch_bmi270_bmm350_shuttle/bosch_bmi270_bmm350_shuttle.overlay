/ {
	aliases {
		accel0 = &bmi270;
		magn0 = &bmm350;
	};
};

&zephyr_i2c {
	status = "okay";

	bmm350: bmm350@14 {
		compatible = "bosch,bmm350";
		reg = <0x14>;
	};

	bmi270: bmi270@69 {
		compatible = "bosch,bmi270";
		reg = <0x69>;
	};
};
